# ─── Local development environment ───────────────────────────────────────────
# Copy this file to server/.env before running npm run dev:all.
#
#   cp server/.env.example server/.env

# Port must match the proxy target in vite.config.ts (http://localhost:3002)
PORT=3002

# JWT secret for local development (any value works here)
JWT_SECRET=dev-secret-local

# Optional: Redis URL. Cache is disabled if not set.
# REDIS_URL=redis://localhost:6379

# Optional: override SQLite storage directory (defaults to server/data/)
# DATA_DIR=./data

# Optional: Ollama URL for local AI chapter extraction.
# Install Ollama (https://ollama.com) and pull a model: ollama pull llama3.2
# OLLAMA_URL=http://localhost:11434

# Optional: Ollama model to use (defaults to llama3.2)
# OLLAMA_MODEL=llama3.2
